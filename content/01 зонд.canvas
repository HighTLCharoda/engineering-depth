		{"id":"eb866ed7403473bd","type":"text","text":"Жилища","x":20,"y":1340,"width":144,"height":52},
		{"id":"0ae88cf535f884ef","type":"text","text":"Субперсоны настроены перепроверять друг друга на сбойность, персона координатор всех процессов","x":685,"y":-641,"width":448,"height":83},
		{"id":"3273cd546afcddf8","type":"text","text":"Это система, использовавшаяся на зондах терраформировавших другие объекты солнечной системы; ее стабильность проверена на практике","x":685,"y":-524,"width":448,"height":102},
		{"id":"04bd42d887e726e8","type":"text","text":"Механитор не нужен, персона занимает его место","x":685,"y":-387,"width":448,"height":52},
		{"id":"13038e423c18fc6e","type":"text","text":"Нужен скан человеческого мозга для сложных субперсон и выше","x":685,"y":-297,"width":448,"height":83},
		{"id":"d94b24eb5b7dbdb4","type":"text","text":"солнечные панели работают вместе с туманоуловителями","x":-132,"y":-190,"width":398,"height":83},
		{"id":"8c1eb9f92c9ce40b","type":"text","text":"Оптимизация атмосферы","x":20,"y":1160,"width":253,"height":52},
		{"id":"f20a1efd061ed567","type":"text","text":"персона на корабельном компьютере, сложные развертываемые субперсоны с простыми подчиненными механоидами","x":-660,"y":-640,"width":255,"height":209}
	],
